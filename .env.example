# FounderFlow AI Environment Variables

# Anthropic Claude API Key (Required for AI agent generation)
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# Tavily Search API Key (Required for live competitor & market web search)
# Get your key at: https://tavily.com/
TAVILY_API_KEY=tvly-...

# Neon Postgres Database URL (Required for persistent storage)
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
DATABASE_URL=postgresql://user:password@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Clerk Authentication (Optional)
# If omitted, FounderFlow AI uses automatic anonymous sessions with cookies
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...

# App URL (Optional, defaults to http://localhost:3000 in dev)
NEXT_PUBLIC_APP_URL=http://localhost:3000

